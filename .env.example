# Stripe Metrics Report — Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# Restricted API key from https://dashboard.stripe.com/apikeys  (rk_live_... or rk_test_...)
# Give it READ access to: Balance, Balance transactions, Charges, PaymentIntents,
# Refunds, Disputes, Payouts, Customers, Subscriptions, Invoices, Checkout Sessions,
# Products, and Radar Early fraud warnings. Anything left out is skipped, not fatal.
STRIPE_API_KEY=rk_live_your_stripe_restricted_key_here

# ─── AWS SES — email sending ───────────────────────────────────────────────────
AWS_REGION=us-east-1

# Leave both blank to use the default credential chain (~/.aws/credentials or IAM role)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Must be a verified SES sender address/domain
FROM_ADDRESS=reports@yourdomain.com
FROM_NAME=James Little

# Comma-separated recipients — verified too if your SES account is in sandbox mode
TO_ADDRESSES=you@yourdomain.com,other@example.com

# ─── Report settings ────────────────────────────────────────────────────────────
# Number of days of history to report (overridable per-run with --days)
REPORT_DAYS=30

# Timezone for report date labels, chart axes, and daily bucketing (IANA name)
TIMEZONE=America/New_York
